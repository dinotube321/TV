TMDB_API_KEY=
TMDB_READ_TOKEN=

# Required in production — use a long random password (12+ chars)
ADMIN_PASSWORD=change-me-strong-admin-password

# Separate secrets for admin vs site JWTs (32+ random chars each in production)
ADMIN_JWT_SECRET=change-me-to-a-long-random-admin-secret-32chars
SITE_JWT_SECRET=change-me-to-a-long-random-site-secret-32chars

PORT=8787
CONTENT_DIR=

# Private data (users.json) — never served publicly
# DATA_DIR=

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# Set to production to enforce strong secrets
# NODE_ENV=production
# PULSE_ENV=production

# Optional: protect hotlinking cache clear
# HOTLINK_ADMIN_SECRET=
